{
  "name": "demo-webshop-automation",
  "version": "1.0.0",
  "description": "Demo Web Shop UI & API Test Automation Framework with Playwright and Postman/Newman",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:q1": "playwright test tests/q1-invalid-login.spec.js",
    "test:q2": "playwright test tests/q2-register-add-to-cart.spec.js",
    "test:q3": "playwright test tests/q3-e2e-search-checkout.spec.js",
    "test:sequential": "playwright test --workers=1",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "test:api": "newman run api-tests/DemoWebShop_API_Test.postman_collection.json -r cli,html --reporter-html-export api-tests/newman-report.html"
  },
  "keywords": ["playwright", "pom", "sqa", "postman", "newman", "allure"],
  "author": "ASHIQ02KHAN",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.7"
  }
}